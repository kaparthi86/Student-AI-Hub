{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easybilling.dev/schemas/billable-fact.json",
  "title": "BillableFact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "tenant_id",
    "account_id",
    "legal_entity_id",
    "meter_id",
    "window",
    "dimensions",
    "quantity",
    "unit",
    "aggregation",
    "watermark",
    "as_of",
    "closed",
    "revision"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "fact_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string", "minLength": 1 },
    "legal_entity_id": { "type": "string", "minLength": 1 },
    "meter_id": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grain", "start", "end"],
      "properties": {
        "grain": { "type": "string", "enum": ["day"] },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "quantity": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$" },
    "unit": { "type": "string", "minLength": 1 },
    "aggregation": { "type": "string", "enum": ["sum"] },
    "watermark": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "closed": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes_fact_id": { "type": ["string", "null"] }
  }
}
