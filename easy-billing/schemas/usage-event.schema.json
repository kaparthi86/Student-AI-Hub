{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easybilling.dev/schemas/usage-event.json",
  "title": "UsageEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "account_id", "meter_id", "timestamp", "quantity"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "account_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "legal_entity_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "meter_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "timestamp": { "type": "string", "format": "date-time" },
    "quantity": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$" },
    "dimensions": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 128 },
      "propertyNames": { "maxLength": 64 }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
