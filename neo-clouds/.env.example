# Neo Clouds Marketplace — copy to .env for local dev (optional; host injects env in production)

NODE_ENV=development
PORT=8788

# Honesty banner is always shown. Optional override for the wording:
# BETA_MESSAGE=Early access: listings, reservations, and inference are simulated. No payments collected.
BETA_TESTING=0

# Seed demo GPU listings and models on boot (good for first deploy; turn off after real providers join)
SEED_DEMO=1

# Shown in /api/health and legal pages
CANONICAL_DOMAIN=neocloudsmarketplace.com
