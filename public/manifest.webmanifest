{
  "name": "Student AI Hub",
  "short_name": "Student AI",
  "description": "Free student AI study coach — Ask questions, get coding help, and turn your notes into quizzes and study plans.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?utm_source=pwa&utm_medium=homescreen",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#F7F6F3",
  "theme_color": "#F7F6F3",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.mystudentcoach.app",
      "id": "com.mystudentcoach.app"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ask a question",
      "short_name": "Ask",
      "description": "Open Ask and start learning",
      "url": "/?tab=chat&utm_source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Code help",
      "short_name": "Code",
      "description": "Debug or learn code",
      "url": "/?tab=code&utm_source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Notebook",
      "short_name": "Notebook",
      "description": "Analyze your study notes",
      "url": "/?tab=notebook&utm_source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  }
}
