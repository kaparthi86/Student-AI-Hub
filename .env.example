# Copy to .env next to server.js

# Hugging Face Inference Providers
HF_API_TOKEN=
# HF_MODEL=deepseek-ai/DeepSeek-V4-Pro:fastest
# HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
# HF_MODEL_VISION=
# Image understanding for Ask (on by default). Set to 0 to disable.
# ENABLE_LEARN_VISION=1

# Supabase (server session verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for thumbs-up/down feedback rows in Supabase (server-only; never put in public/config.js)
# Also run supabase/assistant_feedback.sql in the Supabase SQL Editor.
# Exact name required: SUPABASE_SERVICE_ROLE_KEY (not SUPABASE_KEY / ANON key).
# SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated founder emails allowed to call GET /api/feedback-review (weekly negative thumbs).
# FEEDBACK_REVIEW_EMAILS=you@example.com
# Admin analytics dashboard allowlist (falls back to FEEDBACK_REVIEW_EMAILS if unset).
# Also run supabase/student_intelligence.sql in the Supabase SQL Editor.
# ANALYTICS_ADMIN_EMAILS=you@example.com

# Help & Support form → Google Group / inbox (server-only; address never shown in UI)
# SUPPORT_NOTIFY_TO=student-ai-hub-support@googlegroups.com
# SUPPORT_FROM_EMAIL=support@your-verified-domain.com
# Option A — Resend (https://resend.com): 
# RESEND_API_KEY=
# Option B — SMTP (e.g. Google Workspace):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=app-password-here
# SMTP_SECURE=0

# Live web grounding for Ask (optional — pick one)
# Tavily (recommended): https://tavily.com
TAVILY_API_KEY=
# Or Brave Search: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# Or Serper: https://serper.dev
# SERPER_API_KEY=
# LIVE_WEB_MAX_RESULTS=5

# Optional ops
# PORT=3000
# API_RATE_LIMIT_PER_MINUTE=80
# Public launch: leave BETA_TESTING unset or 0. Set 1 only for invite-only cohorts.
# BETA_TESTING=0
# BETA_MESSAGE=
