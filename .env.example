# Copy to .env next to server.js

# Hugging Face Inference Providers
HF_API_TOKEN=
# HF_MODEL=deepseek-ai/DeepSeek-V4-Pro:fastest
# HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
# HF_MODEL_VISION=
# ENABLE_LEARN_VISION=0

# Supabase (server session verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for thumbs-up/down feedback rows in Supabase (server-only; never put in public/config.js)
# Also run supabase/assistant_feedback.sql in the Supabase SQL Editor.
# SUPABASE_SERVICE_ROLE_KEY=

# Live web grounding for Ask (optional — pick one)
# Tavily (recommended): https://tavily.com
TAVILY_API_KEY=
# Or Brave Search: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# Or Serper: https://serper.dev
# SERPER_API_KEY=
# LIVE_WEB_MAX_RESULTS=5

# Optional ops
# PORT=3000
# API_RATE_LIMIT_PER_MINUTE=80
# BETA_TESTING=0
# BETA_MESSAGE=
