# Copy to .env next to server.js

# Hugging Face Inference Providers
HF_API_TOKEN=
# HF_MODEL=deepseek-ai/DeepSeek-V4-Pro:fastest
# HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
# HF_MODEL_VISION=
# ENABLE_LEARN_VISION=0

# Supabase (server session verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Live web grounding for Ask (optional — pick one)
# Tavily (recommended): https://tavily.com
TAVILY_API_KEY=
# Or Brave Search: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# Or Serper: https://serper.dev
# SERPER_API_KEY=
# LIVE_WEB_MAX_RESULTS=5

# Google Workspace connectors (optional — Calendar + Drive + Gmail)
# Create an OAuth client in Google Cloud Console (Web application).
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://www.my-student-coach.com/api/google/callback
# Local example: http://localhost:3001/api/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=long-random-string
# APP_PUBLIC_URL=https://www.my-student-coach.com

# Optional ops
# PORT=3000
# API_RATE_LIMIT_PER_MINUTE=80
# BETA_TESTING=0
# BETA_MESSAGE=
